import xml.etree.ElementTree as ET
import os, csv, re
import numpy as np
import base64, zlib
from pathlib import Path
from collections import defaultdict


class MzMLParser:
    def __init__(self, f):
        self.f = f
        self.root = None
        self.mzml = None
        self.ns = {}

    def load(self):
        try:
            tree = ET.parse(self.f)
            self.root = tree.getroot()
            tag = self.root.tag
            if '}' in tag:
                self.ns = {'mzml': tag.split('}')[0] + '}'}
            else:
                self.ns = {}
            if 'indexedmzML' in tag:
                self.mzml = self.root.find('.//{*}mzML')
            else:
                self.mzml = self.root
            return self.mzml is not None
        except:
            return False

    def _get_cv(self, el, acc):
        for cv in el.findall('.//{*}cvParam'):
            if cv.get('accession') == acc:
                return cv.get('value')
        return None

    def _scan_num(self, spec):
        sid = spec.get('id', '')
        m = re.search(r'scan=(\d+)', sid)
        if m:
            return int(m.group(1))
        return int(sid) if sid.isdigit() else None

    def _decode(self, arr):
        try:
            dtype = None
            comp = None
            for cv in arr.findall('.//{*}cvParam'):
                acc = cv.get('accession')
                if acc == 'MS:1000523':
                    dtype = 'float64'
                elif acc == 'MS:1000521':
                    dtype = 'float32'
                elif acc == 'MS:1000574':
                    comp = 'zlib'

            be = arr.find('.//{*}binary')
            if be is None or not be.text:
                return None

            raw = base64.b64decode(be.text)
            if comp == 'zlib':
                try:
                    raw = zlib.decompress(raw)
                except:
                    pass

            if dtype == 'float64':
                try:
                    return np.frombuffer(raw, dtype=np.float64)
                except:
                    pass
            if dtype == 'float32':
                try:
                    return np.frombuffer(raw, dtype=np.float32)
                except:
                    pass
            if len(raw) % 8 == 0:
                try:
                    return np.frombuffer(raw, dtype=np.float64)
                except:
                    pass
            if len(raw) % 4 == 0:
                try:
                    return np.frombuffer(raw, dtype=np.float32)
                except:
                    pass
            return None
        except:
            return None

    def find_reporter(self, spec, mzA, mzB, thresh=1e5, tol_ppm=10):
        try:
            prec_mz = None
            prec_int = None
            si = spec.find('.//{*}selectedIon')
            if si is not None:
                for cv in si.findall('.//{*}cvParam'):
                    acc = cv.get('accession')
                    if acc == 'MS:1000744':
                        prec_mz = float(cv.get('value'))
                    elif acc == 'MS:1000042':
                        prec_int = float(cv.get('value'))

            blist = spec.find('.//{*}binaryDataArrayList')
            if blist is None:
                return False, prec_mz, prec_int, None, None, None, None, None, None

            mz_arr = None
            int_arr = None
            for ba in blist.findall('.//{*}binaryDataArray'):
                typ = None
                for cv in ba.findall('.//{*}cvParam'):
                    acc = cv.get('accession')
                    if acc == 'MS:1000514':
                        typ = 'mz'
                    elif acc == 'MS:1000515':
                        typ = 'intensity'
                if typ:
                    d = self._decode(ba)
                    if d is not None:
                        if typ == 'mz':
                            mz_arr = d
                        else:
                            int_arr = d

            if mz_arr is None or int_arr is None:
                return False, prec_mz, prec_int, None, None, None, None, None, None

            n = min(len(mz_arr), len(int_arr))
            mz_arr = mz_arr[:n]
            int_arr = int_arr[:n]

            bestA_mz = bestB_mz = None
            bestA_int = bestB_int = 0
            errA = errB = float('inf')

            for i in range(n):
                m = mz_arr[i]
                it = int_arr[i]
                if it > thresh:
                    ea = abs(m - mzA) / mzA * 1e6
                    if ea <= tol_ppm and ea < errA:
                        errA = ea
                        bestA_mz = m
                        bestA_int = it
                    eb = abs(m - mzB) / mzB * 1e6
                    if eb <= tol_ppm and eb < errB:
                        errB = eb
                        bestB_mz = m
                        bestB_int = it

            if bestA_mz is not None and bestB_mz is not None and bestA_int > thresh and bestB_int > thresh:
                return True, prec_mz, prec_int, bestA_mz, bestA_int, bestB_mz, bestB_int, bestB_int/bestA_int, bestA_int/bestB_int
            return False, prec_mz, prec_int, None, None, None, None, None, None
        except:
            return False, None, None, None, None, None, None, None, None

    def scan(self, mzA, mzB, thresh=1e5, tol_ppm=10):
        out = []
        for spec in self.mzml.findall('.//{*}spectrum'):
            idx = spec.get('index')
            if idx is None:
                continue
            if self._get_cv(spec, 'MS:1000511') != '2':
                continue
            scan = self._scan_num(spec)
            ok, pm, pi, ma, ia, mb, ib, rBA, rAB = self.find_reporter(spec, mzA, mzB, thresh, tol_ppm)
            if ok and pi is not None and pi > thresh:
                out.append({
                    'idx': int(idx),
                    'scan': scan,
                    'pmz': pm,
                    'pint': pi,
                    'mzA': ma,
                    'intA': ia,
                    'mzB': mb,
                    'intB': ib,
                    'rBA': rBA,
                    'rAB': rAB
                })
        return out

    def save(self, results, path):
        if not results:
            return False
        try:
            with open(path, 'w', newline='', encoding='utf-8-sig') as f:
                w = csv.writer(f)
                w.writerow(['scan', 'precursor_mz', 'precursor_intensity',
                            'reporter_mz_A', 'reporter_intensity_A',
                            'reporter_mz_B', 'reporter_intensity_B',
                            'ratio_B/A', 'ratio_A/B'])
                for r in results:
                    w.writerow([
                        r['scan'],
                        f"{r['pmz']:.4f}",
                        f"{r['pint']:.2e}",
                        f"{r['mzA']:.4f}",
                        f"{r['intA']:.2e}",
                        f"{r['mzB']:.4f}",
                        f"{r['intB']:.2e}",
                        f"{r['rBA']:.6f}",
                        f"{r['rAB']:.6f}"
                    ])
            return True
        except:
            return False


def cluster_by_precursor(results, tol=10):
    if not results:
        return []
    sorted_res = sorted(results, key=lambda x: x['pmz'])
    clusters = []
    cur = [sorted_res[0]]
    for r in sorted_res[1:]:
        centroid = np.mean([x['pmz'] for x in cur])
        if abs(r['pmz'] - centroid) / centroid * 1e6 <= tol:
            cur.append(r)
        else:
            clusters.append({
                'centroid': np.mean([x['pmz'] for x in cur]),
                'specs': cur,
                'n': len(cur)
            })
            cur = [r]
    if cur:
        clusters.append({
            'centroid': np.mean([x['pmz'] for x in cur]),
            'specs': cur,
            'n': len(cur)
        })
    return clusters


def find_mzmls(folder):
    p = Path(folder)
    files = []
    for ext in ['*.mzML', '*.mzml']:
        files.extend(p.glob(ext))
    return [str(f) for f in files]


def save_clusters(clusters, path, mzA, mzB):
    try:
        with open(path, 'w', newline='', encoding='utf-8-sig') as f:
            w = csv.writer(f)
            w.writerow(['=' * 80])
            w.writerow(['CLUSTERING SUMMARY'])
            w.writerow([f'Reporter A: {mzA:.4f}, Reporter B: {mzB:.4f}'])
            w.writerow(['=' * 80])
            w.writerow([])

            for ci, cl in enumerate(clusters, 1):
                w.writerow([f'--- Cluster {ci} ---'])
                w.writerow([f'Centroid: {cl["centroid"]:.4f}, n={cl["n"]}'])
                w.writerow([])
                w.writerow(['Scan', 'Prec_mz', 'Prec_int', 'A_mz', 'A_int', 'B_mz', 'B_int', 'B/A', 'A/B'])
                for s in cl['specs']:
                    w.writerow([
                        s['scan'],
                        f"{s['pmz']:.4f}",
                        f"{s['pint']:.2e}",
                        f"{s['mzA']:.4f}",
                        f"{s['intA']:.2e}",
                        f"{s['mzB']:.4f}",
                        f"{s['intB']:.2e}",
                        f"{s['rBA']:.6f}",
                        f"{s['rAB']:.6f}"
                    ])
                w.writerow([])
                w.writerow(['-' * 80])
                w.writerow([])

            w.writerow([])
            w.writerow(['SUMMARY'])
            w.writerow(['Cluster', 'Centroid_mz', 'Count'])
            for ci, cl in enumerate(clusters, 1):
                w.writerow([ci, f"{cl['centroid']:.4f}", cl['n']])
        return True
    except:
        return False


def main():
    print('=' * 60)
    print('MS2 Reporter Ion Search (Clustering Mode)')
    print('=' * 60)

    while True:
        folder = input('\nFolder path: ').strip()
        if os.path.exists(folder) and os.path.isdir(folder):
            break
        print(f'Folder not found: {folder}')

    files = find_mzmls(folder)
    if not files:
        print(f'No .mzML files in {folder}')
        return

    print(f'\nFound {len(files)} file(s):')
    for f in files:
        print(f'  - {os.path.basename(f)}')

    mzA = round(float(input('\nReporter A m/z (e.g., 126): ').strip()), 4)
    mzB = round(float(input('Reporter B m/z (e.g., 127): ').strip()), 4)

    print(f'\nSearching for: A={mzA:.4f}, B={mzB:.4f} (10ppm, 1e5 threshold)')
    print('-' * 60)

    out_dir = os.path.join(folder, 'reporter_clusters')
    os.makedirs(out_dir, exist_ok=True)
    print(f'\nOutput: {out_dir}')

    all_res = []

    for f in files:
        name = os.path.basename(f)
        print(f'\n{"=" * 60}')
        print(f'Processing: {name}')
        print('=' * 60)

        parser = MzMLParser(f)
        if not parser.load():
            print('  Parse failed, skipping')
            continue

        print('  Searching MS2 spectra...')
        res = parser.scan(mzA, mzB, thresh=1e5, tol_ppm=10)

        if not res:
            print('  No hits')
            continue

        print(f'  Found {len(res)} spectra')

        print('  Clustering by precursor m/z...')
        clusters = cluster_by_precursor(res, tol=10)
        print(f'  {len(clusters)} cluster(s):')
        for i, c in enumerate(clusters, 1):
            print(f'    {i}: n={c["n"]}, centroid={c["centroid"]:.4f}')

        base = os.path.splitext(name)[0]
        out_path = os.path.join(out_dir, f'{base}_clusters.csv')
        save_clusters(clusters, out_path, mzA, mzB)
        print(f'  Saved: {out_path}')

        all_res.extend(res)

    if all_res:
        print(f'\n{"=" * 60}')
        print(f'Overall: {len(all_res)} spectra across all files')
        overall = cluster_by_precursor(all_res, tol=10)
        print(f'{len(overall)} overall clusters')
        for i, c in enumerate(overall, 1):
            print(f'  {i}: n={c["n"]}, centroid={c["centroid"]:.4f}')
        overall_path = os.path.join(out_dir, 'ALL_clusters.csv')
        save_clusters(overall, overall_path, mzA, mzB)
        print(f'\nOverall saved: {overall_path}')

    print('\n' + '=' * 60)
    print('Done.')
    print('=' * 60)


if __name__ == '__main__':
    main()
